---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import AboutSection from '../components/AboutSection.astro';
import ContactBlock from '../components/ContactBlock.astro';
import SocialGrid from '../components/SocialGrid.astro';
import HashtagList from '../components/HashtagList.astro';
import Footer from '../components/Footer.astro';

import { profileData } from '../data/profile';
import { SITE_TITLE, SITE_DESCRIPTION, CANONICAL_URL } from '../consts';
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			canonicalUrl={CANONICAL_URL}
		/>
	</head>
	<body>
		<Header />
		<main>
			<!-- Section 1: Header / Hero (Banner, Logo, Title, Mô tả ngắn, CTA Website) -->
			<ProfileHeader
				brand={profileData.brand}
				description={profileData.description}
				media={profileData.media}
				websiteUrl={profileData.social_links.website}
			/>

			<!-- Section 2: Giới thiệu (About - Mô tả dài, Bio HTML, Highlight) -->
			<AboutSection
				description={profileData.description}
				bioHtml={profileData.bio_html}
				personalInfo={profileData.personal_info}
			/>

			<!-- Section 3: Thông tin liên hệ (Contact - Hotline, Email, Địa chỉ, Google Maps placeholder) -->
			<ContactBlock
				contact={profileData.contact}
			/>

			<!-- Section 4: Social Links (Grid 9 nền tảng kèm 5 kênh mới, icon SVG, hover effect) -->
			<SocialGrid
				links={profileData.social_links}
			/>

			<!-- Section 5: Hashtags / Tags (Chip badge tương tác, nút sao chép) -->
			<HashtagList
				hashtags={profileData.hashtags}
			/>
		</main>

		<!-- Section 6: Footer (Copyright, Quick Social Links, Mini Hashtags) -->
		<Footer
			brandTitle={profileData.brand.full_name}
			socialLinks={profileData.social_links}
			hashtags={profileData.hashtags}
		/>
	</body>
</html>
