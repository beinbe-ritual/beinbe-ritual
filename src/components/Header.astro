---
import { profileData } from '../data/profile';
---

<header class="top-nav-bar">
	<nav class="nav-container">
		<a href="/" class="brand-link">
			<span class="logo-leaf">🌿</span>
			<span class="brand-text">{profileData.brand.title_social_short}</span>
		</a>
		<div class="nav-links">
			<a href="#about">Giới thiệu</a>
			<a href="#contact-info">Liên hệ</a>
			<a href="#social-links">Mạng xã hội</a>
			<a href="#hashtags">Hashtags</a>
		</div>
		<div class="header-cta">
			<a href={profileData.social_links.website} target="_blank" rel="noopener noreferrer" class="btn-visit">
				Website
			</a>
		</div>
	</nav>
</header>

<style>
	.top-nav-bar {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-bottom: 1px solid rgba(27, 94, 32, 0.1);
		padding: 0.75rem 1rem;
	}

	.nav-container {
		max-width: 820px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.brand-link {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-weight: 800;
		font-size: 1.2rem;
		color: #1b5e20;
		text-decoration: none;
	}

	.logo-leaf {
		font-size: 1.3rem;
	}

	.nav-links {
		display: flex;
		gap: 1.25rem;
	}

	.nav-links a {
		font-size: 0.9rem;
		font-weight: 600;
		color: #4b5563;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.nav-links a:hover {
		color: #1b5e20;
	}

	.btn-visit {
		background: #1b5e20;
		color: #ffffff;
		padding: 6px 14px;
		border-radius: 8px;
		font-size: 0.85rem;
		font-weight: 700;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}

	.btn-visit:hover {
		background: #2e7d32;
		color: #ffffff;
	}

	@media (max-width: 640px) {
		.nav-links {
			display: none;
		}
	}
</style>
