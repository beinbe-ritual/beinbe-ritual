---
import { formatSocialUrl } from '../utils/helpers';

interface Props {
	platform: string;
	title: string;
	url: string;
	handle?: string;
	isNew?: boolean;
	iconName: 'website' | 'business_site' | 'facebook' | 'instagram' | 'twitter' | 'tiktok' | 'youtube' | 'pinterest' | 'linkedin';
}

const { platform, title, url, handle, isNew = false, iconName } = Astro.props;
const formattedUrl = formatSocialUrl(platform, url);
---

<a
	href={formattedUrl}
	target="_blank"
	rel="noopener noreferrer"
	class="social-card"
	aria-label={`Theo dõi Beinbe trên ${title}`}
>
	<div class="social-icon-wrapper" data-platform={iconName}>
		{iconName === 'website' && (
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon">
				<circle cx="12" cy="12" r="10"></circle>
				<line x1="2" y1="12" x2="22" y2="12"></line>
				<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
			</svg>
		)}
		{iconName === 'business_site' && (
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon">
				<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
				<polyline points="9 22 9 12 15 12 15 22"></polyline>
			</svg>
		)}
		{iconName === 'facebook' && (
			<svg viewBox="0 0 24 24" fill="currentColor" class="icon">
				<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
			</svg>
		)}
		{iconName === 'instagram' && (
			<svg viewBox="0 0 24 24" fill="currentColor" class="icon">
				<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
			</svg>
		)}
		{iconName === 'twitter' && (
			<svg viewBox="0 0 24 24" fill="currentColor" class="icon">
				<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
			</svg>
		)}
		{iconName === 'tiktok' && (
			<svg viewBox="0 0 24 24" fill="currentColor" class="icon">
				<path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.16 1.18 2.09 2.35 2.3 1.25.26 2.61-.2 3.32-1.25.43-.6.64-1.34.66-2.07.03-4.87.01-9.74.02-14.61z"/>
			</svg>
		)}
		{iconName === 'youtube' && (
			<svg viewBox="0 0 24 24" fill="currentColor" class="icon">
				<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
			</svg>
		)}
		{iconName === 'pinterest' && (
			<svg viewBox="0 0 24 24" fill="currentColor" class="icon">
				<path d="M12 0a12 12 0 0 0-4.37 23.18c-.06-.99-.12-2.52.02-3.61l.94-3.99s-.24-.48-.24-1.2c0-1.12.65-1.96 1.46-1.96.69 0 1.02.52 1.02 1.14 0 .69-.44 1.73-.67 2.69-.19.81.41 1.47 1.21 1.47 1.45 0 2.57-1.53 2.57-3.74 0-1.96-1.41-3.33-3.42-3.33-2.5 0-3.96 1.87-3.96 3.81 0 .75.29 1.56.65 2 .07.09.08.17.06.26l-.25 1.01c-.04.16-.14.2-.31.12-1.16-.54-1.88-2.23-1.88-3.59 0-2.92 2.12-5.61 6.13-5.61 3.22 0 5.72 2.29 5.72 5.36 0 3.2-2.02 5.78-4.82 5.78-.94 0-1.83-.49-2.13-1.07l-.58 2.22c-.21.81-.78 1.83-1.16 2.45A11.96 11.96 0 0 0 12 24c6.63 0 12-5.37 12-12S18.63 0 12 0z"/>
			</svg>
		)}
		{iconName === 'linkedin' && (
			<svg viewBox="0 0 24 24" fill="currentColor" class="icon">
				<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
			</svg>
		)}
	</div>
	<div class="social-info">
		<div class="social-header">
			<span class="platform-name">{title}</span>
			{isNew && <span class="badge-new">MỚI</span>}
		</div>
		<span class="social-handle">{handle || formattedUrl.replace(/^https?:\/\//i, '').replace(/\/$/, '')}</span>
	</div>
	<div class="arrow-icon">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
			<path d="M5 12h14"></path>
			<path d="m12 5 7 7-7 7"></path>
		</svg>
	</div>
</a>

<style>
	.social-card {
		display: flex;
		align-items: center;
		padding: 1rem 1.25rem;
		background: #ffffff;
		border: 1px solid rgba(27, 94, 32, 0.12);
		border-radius: 14px;
		text-decoration: none;
		color: #222939;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		position: relative;
		overflow: hidden;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
	}

	.social-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 20px rgba(27, 94, 32, 0.12);
		border-color: #4caf50;
		color: #1b5e20;
	}

	.social-icon-wrapper {
		width: 44px;
		height: 44px;
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		margin-right: 1rem;
		background: #f1f8e9;
		color: #1b5e20;
		transition: transform 0.2s ease, background-color 0.2s ease;
	}

	.social-card:hover .social-icon-wrapper {
		transform: scale(1.08);
		background: #1b5e20;
		color: #ffffff;
	}

	.icon {
		width: 22px;
		height: 22px;
	}

	.social-info {
		display: flex;
		flex-direction: column;
		flex-grow: 1;
		min-width: 0;
	}

	.social-header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.platform-name {
		font-weight: 700;
		font-size: 1.05rem;
		line-height: 1.3;
		color: #1b5e20;
	}

	.badge-new {
		background: #ff9800;
		color: #ffffff;
		font-size: 0.7rem;
		font-weight: 800;
		padding: 2px 6px;
		border-radius: 999px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.social-handle {
		font-size: 0.85rem;
		color: #60739f;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		line-height: 1.4;
	}

	.arrow-icon {
		color: #a0aec0;
		margin-left: 0.5rem;
		flex-shrink: 0;
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.social-card:hover .arrow-icon {
		transform: translateX(4px);
		color: #1b5e20;
	}

	@media (max-width: 480px) {
		.social-card {
			padding: 0.875rem 1rem;
		}
		.social-icon-wrapper {
			width: 38px;
			height: 38px;
			margin-right: 0.75rem;
		}
		.icon {
			width: 19px;
			height: 19px;
		}
		.platform-name {
			font-size: 0.95rem;
		}
		.social-handle {
			font-size: 0.8rem;
		}
	}
</style>
